# Root .htaccess: dipakai bila document root hosting = folder proyek (mis. public_html).
# Semua request diteruskan ke folder public/, file sensitif tidak bisa diakses.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Blokir akses langsung ke file/folder sensitif
    RewriteRule ^(\.env|\.git|composer\.(json|lock)|package(-lock)?\.json|artisan|phpunit\.xml|vite\.config\.js) - [F,L,NC]
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor|node_modules|SRS|dataasli)(/|$) - [F,L,NC]

    # Teruskan ke public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>
<Files ".htaccess">
    Require all denied
</Files>
